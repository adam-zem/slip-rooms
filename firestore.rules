rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Any authenticated user can read profiles (for viewing other users)
      allow read: if request.auth != null;
      // Users can only write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rooms collection - any authenticated user can read/update rooms, only admins can create/delete
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      // Only admins can create rooms
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow update: if request.auth != null; // For userCount/presence tracking
      // Only admins can delete rooms
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      // Messages subcollection - any authenticated user can read/write messages
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.username is string
          && request.resource.data.text is string;
      }
    }

    // Friend requests collection
    match /friendRequests/{requestId} {
      // Anyone can read friend requests (to check if already sent)
      allow read: if request.auth != null;
      // Only the sender can create a request
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid;
      // Both sender and recipient can delete/update (accept/decline)
      allow update, delete: if request.auth != null;
    }

    // Friendships collection
    match /friendships/{friendshipId} {
      allow read: if request.auth != null;
      // Only allow creating friendships where user is one of the parties
      allow create: if request.auth != null;
      // Only allow deleting if user is one of the parties
      allow delete: if request.auth != null;
    }

    // Greatest Hits collection
    match /greatestHits/{hitId} {
      // Anyone can read greatest hits
      allow read: if request.auth != null;
      // Users can only create their own hits
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // Users can only delete their own hits
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Room Submissions collection (for user-submitted rooms pending approval)
    match /roomSubmissions/{submissionId} {
      // Any authenticated user can read submissions (admins need this)
      allow read: if request.auth != null;
      // Any authenticated user can create a submission
      allow create: if request.auth != null
        && request.resource.data.oddieid == request.auth.uid
        && request.resource.data.prop is string
        && request.resource.data.sport is string
        && request.resource.data.status == "pending";
      // Only admins can update (approve/reject) - for now allow any authenticated user
      // In production, add admin check: && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      allow update: if request.auth != null;
      // Only admins can delete
      allow delete: if request.auth != null;
    }

    // Broadcasts collection (admin/mod push notification audit log)
    // Only Cloud Functions can write (using admin SDK); any authenticated user can read for transparency
    match /broadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Posts collection - core social feed content
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      // Author can update anything; any auth user can update ONLY engagement fields
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'metrics',
                'upvotes',
                'thumbsUp',
                'thumbsUpCount',
                'downvotes',
                'thumbsDown',
                'thumbsDownCount',
                'voteScore',
                'reposts',
                'repostsCount',
                'replies',
                'repliesCount',
                'commentsCount'
              ]));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Likes collection - upvote tracking
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Upvotes collection - alternative upvote tracking
    match /upvotes/{upvoteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.oddieid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.oddieid == request.auth.uid;
    }

    // Dislikes collection - downvote tracking
    match /dislikes/{dislikeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Reposts collection - repost tracking
    match /reposts/{repostId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Followers collection - follow relationship tracking
    match /followers/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Hashtags collection - trending and usage tracking
    match /hashtags/{hashtagId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Usernames collection - username reservation/lookup
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // Notifications collection - user notification inbox
    match /notifications/{notificationId} {
      // Only the owner (user the notif is for) can read
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // Anyone authenticated can create notifications (because actors create notifs for other users)
      allow create: if request.auth != null;
      // Only the owner can update (e.g., marking as read)
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // Only the owner can delete
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Conversations collection - DM threads
    match /conversations/{conversationId} {
      // Only participants can read the conversation
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      // Only allow creating conversations that include the creator as a participant
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      // Only participants can update (e.g., updating lastMessage, unread counts, etc.)
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      // No deletes for now (DMs aren't user-deletable yet)
      allow delete: if false;

      // Messages subcollection - same participant gating
      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        // Only conversation participants AND only as the sender can create messages
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        // No edits, no deletes (per Jake — both planned for future)
        allow update: if false;
        allow delete: if false;
      }
    }

    // Reports collection - user-submitted reports for moderation review
    match /reports/{reportId} {
      // Only admins and mods can read reports
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isMod == true);
      // Any authenticated user can submit a report
      allow create: if request.auth != null;
      // Only admins and mods can update (mark resolved, etc.) or delete
      allow update, delete: if request.auth != null
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isMod == true);
    }

    // Admin logs - audit log of admin actions
    match /adminLogs/{logId} {
      // Only admins can read or write
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Banned words - admin-managed filter list
    match /bannedWords/{wordId} {
      // Any authenticated user can read (frontend filter check)
      allow read: if request.auth != null;
      // Only admins can write
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Filter logs - logs of filter violations
    match /filterLogs/{logId} {
      // Only admins can read
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      // Any authenticated user can create (frontend logs the violation)
      allow create: if request.auth != null;
      // Only admins can update or delete
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Presence - online/offline status tracking
    match /presence/{userId} {
      // Any authenticated user can read presence
      allow read: if request.auth != null;
      // Only the user themselves can write their own presence
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Friends collection - cleanup collection
    match /friends/{friendId} {
      // Any authenticated user can read (in case any frontend uses this)
      allow read: if request.auth != null;
      // Any authenticated user can write (matches existing friendships rule pattern)
      allow write: if request.auth != null;
    }
  }
}
