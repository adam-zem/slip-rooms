rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Usernames collection - for username reservation during signup
    match /usernames/{username} {
      // Anyone can read (to check username availability during signup)
      allow read: if true;
      // Only authenticated users can create (reserve their username)
      // Note: accountService.js writes "userId" field, not "uid"
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // No updates allowed - usernames are permanent
      allow update: if false;
      // Only the owner or admin can delete
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Users collection
    match /users/{userId} {
      // Any authenticated user can read profiles (for viewing other users)
      allow read: if request.auth != null;
      // Users can create their own profile (during signup)
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users can update their own profile
      allow update: if request.auth != null && request.auth.uid == userId;
      // Admins can update any profile (for banning, etc.)
      allow update: if isAdmin();
      // Only admins can delete user profiles
      allow delete: if isAdmin();

      // Badges subcollection
      match /badges/{badgeId} {
        // Anyone authenticated can read badges (for profile viewing)
        allow read: if request.auth != null;
        // Users can only write their own badges
        allow create, update: if request.auth != null && request.auth.uid == userId;
        // Only admins can delete badges
        allow delete: if isAdmin();
      }
    }

    // Rooms collection
    match /rooms/{roomId} {
      // Any authenticated user can read rooms
      allow read: if request.auth != null;
      // Any authenticated user can create rooms
      allow create: if request.auth != null;
      // Any authenticated user can update (for userCount/presence tracking)
      allow update: if request.auth != null;
      // Only admins can delete rooms
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null;
        // Allow creating messages with required fields
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username is string;
        // Admins can update/delete messages (moderation)
        allow update, delete: if isAdmin();
      }
    }

    // Conversations collection (DMs)
    // Conversation IDs are formatted as "userId1_userId2" (sorted alphabetically)
    match /conversations/{conversationId} {
      // Helper to check if user is part of conversation by ID pattern
      // This works for non-existent documents (checking before create)
      function isParticipantById() {
        return conversationId.matches('.*' + request.auth.uid + '.*');
      }

      // Helper to check if user is in participants array (for existing docs)
      function isParticipantInArray() {
        return request.auth.uid in resource.data.participants;
      }

      // Users can read conversations they're part of
      // - isParticipantById(): for get() on potentially non-existent docs
      // - isParticipantInArray(): for list queries on existing docs
      allow read: if request.auth != null
        && (isParticipantById() || isParticipantInArray());

      // Users can create conversations they're part of
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && isParticipantById();

      // Users can update conversations they're part of (mark as read, etc.)
      allow update: if request.auth != null && isParticipantInArray();

      // Admins can delete conversations
      allow delete: if isAdmin();

      // DM Messages subcollection
      match /messages/{messageId} {
        // Read if user is in the parent conversation (check by ID pattern)
        // Note: We check the parent conversation ID contains the user's UID
        allow read: if request.auth != null
          && conversationId.matches('.*' + request.auth.uid + '.*');

        // Create if user is authenticated and is the sender
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;

        // Admins can update/delete
        allow update, delete: if isAdmin();
      }
    }

    // Friend requests collection
    match /friendRequests/{requestId} {
      // Anyone can read friend requests (to check if already sent)
      allow read: if request.auth != null;
      // Only the sender can create a request
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid;
      // Both sender and recipient can delete/update (accept/decline)
      allow update, delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Friendships collection
    match /friendships/{friendshipId} {
      allow read: if request.auth != null;
      // Allow creating friendships where user is one of the parties
      // Note: friendsService.js writes "user1" and "user2" fields
      allow create: if request.auth != null
        && (request.resource.data.user1 == request.auth.uid
            || request.resource.data.user2 == request.auth.uid);
      // Allow deleting if user is one of the parties
      allow delete: if request.auth != null
        && (resource.data.user1 == request.auth.uid
            || resource.data.user2 == request.auth.uid);
    }

    // Posts collection (unified social wall - posts, replies, quotes)
    match /posts/{postId} {
      // Anyone authenticated can read posts
      allow read: if request.auth != null;
      // Users can create their own posts (supports both authorId and legacy userId)
      allow create: if request.auth != null
        && (request.resource.data.authorId == request.auth.uid
            || request.resource.data.userId == request.auth.uid);
      // Any authenticated user can update posts for:
      // - Incrementing reply/like counts (when someone engages with the post)
      // - Editing own posts
      // Note: Fine-grained control should be handled at app level
      allow update: if request.auth != null;
      // Only post owner or admin can delete
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || resource.data.userId == request.auth.uid
            || isAdmin());

      // Comments subcollection (legacy - kept for backward compatibility)
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        // Comment owner or admin can delete
        allow delete: if request.auth != null
          && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Likes collection (for post likes)
    // Document ID format: {userId}_{postId}
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // No updates allowed - likes are binary (exists or not)
      allow update: if false;
    }

    // Dislikes collection (for post dislikes)
    // Document ID format: {userId}_{postId}
    match /dislikes/{dislikeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // No updates allowed - dislikes are binary (exists or not)
      allow update: if false;
    }

    // Reposts collection (for post reposts)
    // Document ID format: {userId}_{postId}
    match /reposts/{repostId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // No updates allowed - reposts are binary (exists or not)
      allow update: if false;
    }

    // Greatest Hits collection
    match /greatestHits/{hitId} {
      // Anyone authenticated can read greatest hits
      allow read: if request.auth != null;
      // Users can only create their own hits
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // Users can only delete their own hits, admins can delete any
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Room Submissions collection (for user-submitted rooms pending approval)
    match /roomSubmissions/{submissionId} {
      // Any authenticated user can read submissions
      allow read: if request.auth != null;
      // Any authenticated user can create a submission
      allow create: if request.auth != null
        && request.resource.data.oddieid == request.auth.uid
        && request.resource.data.prop is string
        && request.resource.data.sport is string
        && request.resource.data.status == "pending";
      // Only admins can update (approve/reject)
      allow update: if isAdmin();
      // Only admins or the submitter can delete
      allow delete: if request.auth != null
        && (resource.data.oddieid == request.auth.uid || isAdmin());
    }

    // Admin settings collection
    match /settings/{settingId} {
      // Anyone authenticated can read settings
      allow read: if request.auth != null;
      // Only admins can write settings
      allow write: if isAdmin();
    }

    // Admin logs collection
    match /adminLogs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();
      // Only admins can create logs
      allow create: if isAdmin();
      // No updates or deletes
      allow update, delete: if false;
    }

    // Presence collection (for tracking online users)
    match /presence/{oddieid} {
      // Anyone authenticated can read presence
      allow read: if request.auth != null;
      // Users can only write their own presence
      allow write: if request.auth != null && request.auth.uid == oddieid;
    }

    // Banned words collection (for profanity filter)
    match /bannedWords/{wordId} {
      // Anyone can read (needed for profanity filter during signup before auth)
      allow read: if true;
      // Only admins can manage banned words
      allow write: if isAdmin();
    }

    // Filter logs collection (for tracking filter violations)
    match /filterLogs/{logId} {
      // Only admins can read filter logs
      allow read: if isAdmin();
      // Authenticated users can create logs (when their message is blocked)
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // No updates or deletes
      allow update, delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // Any authenticated user can create notifications (for others)
      allow create: if request.auth != null;
      // Users can update their own notifications (mark as read)
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // Users can delete their own notifications
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
