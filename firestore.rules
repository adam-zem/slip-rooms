rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // HELPER FUNCTIONS
    // =================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isAdminOrMod() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
         || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isMod == true);
    }

    // =================================================================
    // USER & AUTH
    // =================================================================

    // Users collection
    match /users/{userId} {
      // Any authenticated user can read profiles (for viewing other users)
      allow read: if isSignedIn();
      // Users can only write their own profile
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Usernames collection - username reservation/lookup
    match /usernames/{username} {
      // Username availability must be checkable during signup, before the auth user exists.
      // Docs only contain {uid, createdAt}; the handle is already public.
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if false;
      // Allow delete only if the username belongs to the authenticated user
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Presence - online/offline status tracking
    match /presence/{userId} {
      // Any authenticated user can read presence
      allow read: if isSignedIn();
      // Only the user themselves can write their own presence
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // =================================================================
    // CONTENT
    // =================================================================

    // Posts collection - core social feed content
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      // Author can update anything; any auth user can update ONLY engagement fields
      allow update: if isSignedIn()
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'metrics',
                'upvotes',
                'downvotes',
                'voteScore',
                'reposts',
                'repostsCount',
                'replies',
                'repliesCount',
                'commentsCount'
              ]));
      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Hashtags collection - trending and usage tracking
    match /hashtags/{hashtagId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // =================================================================
    // ENGAGEMENT
    // =================================================================

    // Upvotes collection - primary upvote tracking
    match /upvotes/{upvoteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (request.resource.data.oddieid == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn()
        && (resource.data.oddieid == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Reposts collection - repost tracking
    match /reposts/{repostId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Followers collection - follow relationship tracking
    match /followers/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // =================================================================
    // MESSAGING
    // =================================================================

    // Rooms collection - chat rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      // Authenticated users can create rooms (must set createdBy to their own uid)
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn(); // For userCount/presence tracking
      // Only admins can delete rooms
      allow delete: if isAdmin();

      // Messages subcollection - any authenticated user can read/write messages
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.username is string
          && request.resource.data.text is string;
      }
    }

    // Conversations collection - DM threads
    match /conversations/{conversationId} {
      // Only participants can read the conversation (resource == null allows existence checks)
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      // Only allow creating conversations that include the creator as a participant
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      // Only participants can update (e.g., updating lastMessage, unread counts, etc.)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      // No deletes for now (DMs aren't user-deletable yet)
      allow delete: if false;

      // Messages subcollection - same participant gating
      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        // Only conversation participants AND only as the sender can create messages
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        // No edits, no deletes (message editing planned for future)
        allow update: if false;
        allow delete: if false;
      }
    }

    // Notifications collection - user notification inbox
    match /notifications/{notificationId} {
      // Only the owner (user the notif is for) can read
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      // Anyone authenticated can create notifications (because actors create notifs for other users)
      allow create: if isSignedIn();
      // Only the owner can update (e.g., marking as read)
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      // Only the owner can delete
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // =================================================================
    // ROOMS & SUBMISSIONS
    // =================================================================

    // Room Submissions collection (for user-submitted rooms pending approval)
    match /roomSubmissions/{submissionId} {
      // Any authenticated user can read submissions (admins need this)
      allow read: if isSignedIn();
      // Any authenticated user can create a submission
      allow create: if isSignedIn()
        && (request.resource.data.oddieid == request.auth.uid || request.resource.data.userId == request.auth.uid)
        && request.resource.data.prop is string
        && request.resource.data.sport is string
        && request.resource.data.status == "pending";
      // TODO: tighten to admin-only updates. Currently permissive while moderation workflow is in development.
      allow update: if isSignedIn();
      // Only admins can delete
      allow delete: if isSignedIn();
    }

    // =================================================================
    // ADMIN & MODERATION
    // =================================================================

    // Reports collection - user-submitted reports for moderation review
    match /reports/{reportId} {
      // Only admins and mods can read reports
      allow read: if isAdminOrMod();
      // Any authenticated user can submit a report
      allow create: if isSignedIn();
      // Only admins and mods can update (mark resolved, etc.) or delete
      allow update, delete: if isAdminOrMod();
    }

    // Admin logs - audit log of admin actions
    match /adminLogs/{logId} {
      // Only admins can read or write
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Banned words - admin/mod managed filter list (HARD LIST - starred everywhere except DMs)
    match /bannedWords/{wordId} {
      // Any authenticated user can read (frontend filter check)
      allow read: if isSignedIn();
      // Admins and mods can write
      allow write: if isAdminOrMod();
    }

    // Blocked hashtags - admin/mod managed filter list (SOFT LIST - can't trend, shows no results)
    match /blockedHashtags/{hashtagId} {
      // Any authenticated user can read (frontend hashtag check)
      allow read: if isSignedIn();
      // Admins and mods can write
      allow write: if isAdminOrMod();
    }

    // Filter logs - logs of filter violations
    match /filterLogs/{logId} {
      // Only admins can read
      allow read: if isAdmin();
      // Any authenticated user can create (frontend logs the violation)
      allow create: if isSignedIn();
      // Only admins can update or delete
      allow update, delete: if isAdmin();
    }

    // Broadcasts collection (admin/mod push notification audit log)
    // Only Cloud Functions can write (using admin SDK); any authenticated user can read for transparency
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

  }
}
